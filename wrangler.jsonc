{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bruno-intranet",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-15",
  // Pflicht für OAuth-Clients mit Metadaten-Dokument (z. B. Claude): Abrufe nur ins öffentliche Netz.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/authorize", "/oauth/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bruno-intranet",
      "database_id": "7b251dff-5aed-4b17-9aa2-44ddbf616003",
      "migrations_dir": "migrations"
    }
  ],
  // OAuth-Clients, Freigaben und Tokens (Tokens nur als Hash)
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "fd85f6dacb0d4efb97d92e0fb485b1db" }],
  "observability": { "enabled": true }
}
